{
  "name": "@sphinxcorp/opencode-egm",
  "version": "0.2.0",
  "description": "OpenCode V2 plugin for the Elephant & Goldfish Model (EGM).",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "egm",
    "elephant-goldfish-model"
  ],
  "author": "SphinxCorp",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sphinxcorp/opencode-egm.git"
  },
  "homepage": "https://github.com/sphinxcorp/opencode-egm#readme",
  "bugs": {
    "url": "https://github.com/sphinxcorp/opencode-egm/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -rf dist/bundle && cp -r bundle dist/bundle",
    "prepublishOnly": "npm run build && npm run validate && npm test",
    "test": "node --experimental-strip-types tests/unit/opencode_plugin_harness.mjs .",
    "validate": "node scripts/validate-bundle.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  }
}
